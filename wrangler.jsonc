{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "vivobuy",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference service binding; the service name must match the worker name
      "binding": "WORKER_SELF_REFERENCE",
      "service": "vivobuy"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vivobuy",
      "database_id": "f74b680d-639a-49bd-a9c6-054b52df5a9a",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://vivobuy.diegonatel.workers.dev"
  },
  // BETTER_AUTH_SECRET is a secret: `wrangler secret put BETTER_AUTH_SECRET` (local: .dev.vars)
  "observability": {
    "enabled": true
  }
}
