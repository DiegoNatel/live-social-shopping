{
  "$schema": "node_modules/wrangler/config-schema.json",
  // worker.ts wraps the OpenNext worker and adds the LiveRoom Durable Object
  "main": "worker.ts",
  "name": "watchhaul",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference service binding; the service name must match the worker name
      "binding": "WORKER_SELF_REFERENCE",
      "service": "watchhaul"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "watchhaul",
      "database_id": "3553079a-813a-48f8-b04d-b7cf6d6b7c65",
      "migrations_dir": "migrations"
    }
  ],
  // One LiveRoom per live stream: chat, reactions, viewer counts, auction endings
  "durable_objects": {
    "bindings": [{ "name": "LIVE_ROOM", "class_name": "LiveRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveRoom"] }],
  // Closes auctions nobody was watching when they ended (see scheduled() in worker.ts)
  "triggers": { "crons": ["*/5 * * * *"] },
  // Product photos and stream thumbnails uploaded by sellers (served by /images/[...key])
  // Create once with: npx wrangler r2 bucket create watchhaul-images
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "watchhaul-images"
    }
  ],
  // The site's address. www redirects to the bare domain (see worker.ts)
  "routes": [
    { "pattern": "watchhaul.com", "custom_domain": true },
    { "pattern": "www.watchhaul.com", "custom_domain": true }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://watchhaul.com"
  },
  // BETTER_AUTH_SECRET is a secret: `wrangler secret put BETTER_AUTH_SECRET` (local: .dev.vars)
  "observability": {
    "enabled": true
  }
}
