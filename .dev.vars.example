BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Optional: Google login (console.cloud.google.com → Credentials → OAuth client ID, type Web)
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: live video (cloud.livekit.io → project → Settings → Keys)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional: record lives to R2 (R2 → Manage API tokens, Object Read & Write on vivobuy-images)
RECORDINGS_S3_ENDPOINT=
RECORDINGS_S3_ACCESS_KEY=
RECORDINGS_S3_SECRET=
# Optional: payments (sandbox.asaas.com → Integrações → Chave de API; webhook token is any long random string)
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# ASAAS_ENV=production
# Optional: freight quotes (sandbox.melhorenvio.com.br → Integrações → Permissões de acesso → Gerar token)
MELHOR_ENVIO_TOKEN=
# MELHOR_ENVIO_ENV=production
# MELHOR_ENVIO_CONTACT=voce@exemplo.com
# Optional: e-mail (app.brevo.com → SMTP & API → API keys; EMAIL_FROM is a sender confirmed in Brevo)
BREVO_API_KEY=
EMAIL_FROM=
